# سرویس systemd برای اجرای دائمی ربات سیگنال (لینوکس).
#
# نصب:
#   sudo cp deploy/garnet-trader.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now garnet-trader
#
# لاگ:  journalctl -u garnet-trader -f
#
# ⚠️ این سرویس هیچ سفارشی ثبت نمی‌کند.
#
# مسیرها و کاربر را با محیط خودتان جایگزین کنید.

[Unit]
Description=GarnetTrader — ربات سیگنال آپشن بورس تهران (فقط سیگنال)
Documentation=https://github.com/OmidRafiee/GarnetTrader
# منبع داده TSETMC است، پس بدون شبکه شروع نشود
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=garnet
Group=garnet
WorkingDirectory=/opt/garnet-trader/option_signal_bot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=Asia/Tehran
# توکن هرگز در این فایل نمی‌نشیند: فایل سرویس معمولاً قابل خواندن است.
# با chmod 600 و مالکیت کاربر سرویس بسازیدش.
EnvironmentFile=-/etc/garnet-trader.env

ExecStart=/opt/garnet-trader/option_signal_bot/.venv/bin/python main.py

# ری‌استارت خودکار. قطعی TSETMC یا خطای گذرا نباید ربات را برای همیشه
# بخواباند، ولی حلقه‌ی ری‌استارتِ سریع هم لاگ را پر می‌کند.
Restart=on-failure
RestartSec=30s
# اگر در ۵ دقیقه بیش از ۵ بار ری‌استارت شد، مشکل گذرا نیست — بایست
# تا آدم ببیند.
StartLimitBurst=5
StartLimitIntervalSec=300

# سخت‌سازی: این ربات فقط به شبکه و پوشه‌ی خودش نیاز دارد.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# تنها مسیری که نوشتن لازم دارد: خروجی اجرا (دیتابیس، لاگ سیگنال، کش)
ReadWritePaths=/opt/garnet-trader/option_signal_bot/var
ReadWritePaths=/opt/garnet-trader/option_signal_bot/config

[Install]
WantedBy=multi-user.target
